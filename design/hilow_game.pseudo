# IT 140 Module Four Assignment
# Higher/Lower Game Pseudocode Template
#
# Complete the TODO prompts below with your own pseudocode.
# Keep this file in .pseudo format for submission.
#
# Use clear indentation to show decisions and repeated behavior.
# Your finished pseudocode should address every requirement in the
# current Module Four Assignment Guidelines and Rubric.

START Dawna_lucky_number

    # Establish a valid guessing range.
    OUTPUT "Enter the lower bound:"
    INPUT lower_bound
    OUTPUT "Enter the upper bound:"
    INPUT upper_bound

    WHILE lower_bound >= upper_bound
        OUTPUT "The lower bound must be less than the upper bound."
        OUTPUT "Enter the lower bound:"
        INPUT lower_bound
        OUTPUT "Enter the upper bound:"
        INPUT upper_bound
    END WHILE

    # Establish the number the player is trying to guess.
    SET random_number = RANDOM number between lower_bound and upper_bound

    # Play the game.
    OUTPUT "Guess a number between the lower and upper bounds:"
    INPUT guess

    WHILE guess < lower_bound OR guess > upper_bound 
        OUTPUT "Please enter a number within the lower and upper bounds."
        INPUT guess
END WHILE

WHILE guess != random_number
    If guess < random_number
        OUTPUT "Nope, too low."
    ELSE
        OUTPUT "Nope, too high."
    END IF
    OUTPUT "Guess another number:"
    INPUT guess
    WHILE guess < lower_bound OR guess > upper_bound
        OUTPUT "Please enter a number within the lower and upper bounds."
        INPUT guess
    END WHILE
END WHILE

OUTPUT "You got it!"

# AI Acknowledgment: I used Microsoft Copilot as a learning aid to help explain pseudocode concepts, understand loops and decision branching, and review my completed pseudocode.

END Dawna_lucky_number
